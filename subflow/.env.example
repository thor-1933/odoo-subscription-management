# SubFlow Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection
DATABASE_URL="file:./dev.db"

# Authentication Secrets
# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REPLACE_WITH_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS"
JWT_EXPIRES_IN="7d"

# Client URL
CLIENT_URL="http://localhost:5173"
# Comma-separated additional trusted origins, for example a deployed frontend URL.
CORS_ALLOWED_ORIGINS=""

# SMTP is optional locally; password reset emails are not sent unless all are configured.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Brightloop Software <billing@brightloop.io>"

# Background Scheduler
BILLING_SCHEDULER_CRON="0 0 * * *"
ENABLE_BACKGROUND_SCHEDULER="true"
